# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=

# Where form submissions are emailed
CONTACT_TO_EMAIL=sparrowgaragedoors@gmail.com

# Public site origin, used for canonical URLs, sitemap, Open Graph and JSON-LD.
# No trailing slash. Set this to your live domain.
NEXT_PUBLIC_SITE_URL=https://www.sparrowgaragedoors.com

# Google Tag Manager container ID. Optional: leave empty to use the live
# container (GTM-PM22WN57) that is built into the site.
NEXT_PUBLIC_GTM_ID=

# Admin dashboard login (/admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Vercel Blob storage for admin content + image uploads (auto-set when you
# create a Blob store in the Vercel dashboard; leave empty for local dev,
# which falls back to content/site-content.json and public/uploads)
BLOB_READ_WRITE_TOKEN=
